{
  "name": "soonot",
  "private": true,
  "version": "0.1.0",
  "description": "Small multiplayer web games for church gatherings. One event, one master user, one process, two games.",
  "workspaces": [
    "master",
    "bingo",
    "yutnori"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm --workspace @soonot/master run build",
    "start": "npm --workspace @soonot/master run start",
    "dev": "npm run dev -w @soonot/master",
    "test": "vitest run",
    "test:master": "npm run test -w @soonot/master",
    "typecheck": "tsc -b",
    "hash-passcode": "npm run hash-passcode -w @soonot/master",
    "verify": "bash scripts/verify.sh"
  }
}
