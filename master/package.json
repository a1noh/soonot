{
  "name": "@soonot/master",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The shared master user and event host: identity, events, dispatch, persistence, the projector.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/index.server.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx src/index.server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "hash-passcode": "tsx scripts/hash-passcode.ts"
  },
  "dependencies": {
    "cookie": "^0.6.0",
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.7.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
